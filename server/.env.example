# App Config
APP_ENV=development
APP_PORT=8080
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Config
DB_HOST=localhost
DB_PORT=5432
DB_USER=flybook_user
DB_PASSWORD=flybook_secret
DB_NAME=flybook_db
DB_SSLMODE=disable

# MongoDB Config
MONGO_URI=mongodb://flybook_admin:flybook_secret@localhost:27017/flybook_nosql?authSource=admin
MONGO_DB=flybook_nosql

# Redis Config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=flybook_secret

# JWT Config
JWT_SECRET=super_secret_flybook_jwt_key_at_least_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Midtrans Config
MIDTRANS_SERVER_KEY=SB-Mid-server-your-key-here
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-key-here
MIDTRANS_IS_PRODUCTION=false
